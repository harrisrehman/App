{
  "appId": "com.harrisrehman.annex",
  "appName": "Annex",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "harrisrehman.github.io",
      "raw.githack.com",
      "rawcdn.githack.com",
      "raw.githubusercontent.com",
      "cdn.jsdelivr.net"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0e0e10"
    }
  }
}
